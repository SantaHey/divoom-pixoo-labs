{
  "name": "pixoo-drawer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.js",
    "web": "node web/server.js",
    "simulator": "node simulator/server.js",
    "bluetooth": "node bluetooth/server.js",
    "example": "node main.js",
    "online:setup": "node scripts/cloudflare-setup.js",
    "rebuild": "pnpm rebuild bluetooth-serial-port",
    "dev:ports": "cross-env WEB_PORT=3010 SIMULATOR_PORT=3011 BLUETOOTH_PORT=3012 node dev.js"
  },
  "dependencies": {
    "bluetooth-serial-port": "git+https://github.com/tinyprinter/node-bluetooth-serial-port.git",
    "debug": "^4.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bluetooth-serial-port"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "node-gyp": "^13.0.2"
  }
}
